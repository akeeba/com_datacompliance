# Configuration for the Dockerized end-to-end test stack.
#
# Copy this file to .env and edit as needed, or just run ./run.sh, which creates
# .env from this template automatically on first run.
#
# This template IS committed to git. Do not add local-only settings here; put
# them in .env, which is not.

# ----------------------------------------------------------------------------
# Versions — every component is configurable.
# ----------------------------------------------------------------------------
# The Joomla and PHP versions under test (JOOMLA_VERSION, PHP_VERSION, JOOMLA_MATRIX) are NOT set here:
# setting them in this file or in .env has no effect. They are committed in
# ../../../../buildfiles/docker/e2e/matrix (shared by every project), plus this directory's matrix.env
# where the project needs more. Use run.sh --joomla / --php for a one-off. Drop a package into
# ../inbox/ to pin an exact Joomla build offline.

# Image tags. PHP and Apache are the shared akeeba-e2e/* images (see docker/e2e/versions in the
# sibling buildfiles repository); the rest are stock images. The PHP version is part of the
# committed matrix (see above), so it is not set here.
APACHE_VERSION=2.4
MYSQL_VERSION=8.4
MAILPIT_VERSION=v1.21
# MinIO no longer publishes images to Docker Hub; quay.io still carries them.
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
MC_VERSION=RELEASE.2025-08-13T08-35-41Z

# ----------------------------------------------------------------------------
# Sibling extensions.
#
# Data Compliance ships integration plugins for Akeeba Ticket System and Akeeba
# Release System. run.sh builds both from the sibling working copies (../ats and
# ../ars, relative to this repository) with `phing git` and installs them, so
# plg_datacompliance_ats and plg_datacompliance_ars run against the real tables.
# Set to 0 to skip one; the tests that need it then skip themselves.
# ----------------------------------------------------------------------------
WITH_ATS=1
WITH_ARS=1

# ----------------------------------------------------------------------------
# Host ports. Chosen not to collide with the sibling harnesses — Admin Tools
# (8080/8081/33306/8025), ATS (8090/8091/33307/8125), Akeeba Backup
# (8090/33406/18025), ARS (8100/33308/8135) and com_compatibility (8110/33309) —
# so this stack can be up alongside any of them.
# ----------------------------------------------------------------------------
# The Apache-served site: http://localhost:${HTTP_PORT}
HTTP_PORT=8120
# MySQL, published for the host-side PHPUnit process.
DB_PORT=33310
# Mailpit's REST API and web UI: http://localhost:${MAILPIT_HTTP_PORT}
MAILPIT_HTTP_PORT=8145

# ----------------------------------------------------------------------------
# Database.
# ----------------------------------------------------------------------------
DB_NAME=dce2e
DB_USER=dce2e
DB_PASSWORD=dce2e
DB_ROOT_PASSWORD=root
DB_PREFIX=e2e_

# ----------------------------------------------------------------------------
# S3-compatible storage (MinIO) for plg_datacompliance_s3. Reachable only inside
# the compose network, as http://minio:9000.
# ----------------------------------------------------------------------------
S3_ACCESS_KEY=dce2eaccess
S3_SECRET_KEY=dce2esecret
S3_BUCKET=dc-audit

# ----------------------------------------------------------------------------
# Site and the Super User. Every other account is created by the provisioner;
# see tests/integration/assets/e2e-provision.php for the ACL matrix.
# ----------------------------------------------------------------------------
SITE_NAME="Data Compliance End-to-End"
ADMIN_NAME="Test Super User"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=test
ADMIN_EMAIL=admin@example.test

# The password given to every provisioned non-admin account.
TEST_USER_PASSWORD=test

# ----------------------------------------------------------------------------
# Outbound mail. Joomla is pointed at Mailpit over real SMTP.
# ----------------------------------------------------------------------------
MAIL_FROM=privacy@example.test
MAIL_FROM_NAME="Data Compliance E2E"
