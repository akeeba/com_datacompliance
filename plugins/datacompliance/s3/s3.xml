<extension type="plugin" group="datacompliance" method="upgrade">
    <name>PLG_DATACOMPLIANCE_S3</name>
    <author>Nicholas K. Dionysopoulos</author>
    <authorEmail>nicholas@akeeba.com</authorEmail>
    <authorUrl>https://www.akeeba.com</authorUrl>
    <copyright>Copyright (c)2018-2025 Nicholas K. Dionysopoulos / Akeeba Ltd</copyright>
    <license>GNU General Public License version 3, or later</license>
    <creationDate>2026-08-26</creationDate>
    <version>4.0.3</version>
    <description>PLG_DATACOMPLIANCE_S3_DESCRIPTION</description>
    <namespace path="src">Akeeba\Plugin\DataCompliance\S3</namespace>

    <files>
        <folder>language</folder>
        <folder>services</folder>
        <folder plugin="s3">src</folder>

        <filename>.htaccess</filename>
        <filename>web.config</filename>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/plg_datacompliance_s3.ini</language>
        <language tag="en-GB">en-GB/plg_datacompliance_s3.sys.ini</language>
        <language tag="el-GR">el-GR/plg_datacompliance_s3.ini</language>
        <language tag="el-GR">el-GR/plg_datacompliance_s3.sys.ini</language>
        <language tag="fr-FR">fr-FR/plg_datacompliance_s3.ini</language>
        <language tag="fr-FR">fr-FR/plg_datacompliance_s3.sys.ini</language>
        <language tag="de-DE">de-DE/plg_datacompliance_s3.ini</language>
        <language tag="de-DE">de-DE/plg_datacompliance_s3.sys.ini</language>
        <language tag="es-ES">es-ES/plg_datacompliance_s3.ini</language>
        <language tag="es-ES">es-ES/plg_datacompliance_s3.sys.ini</language>
        <language tag="it-IT">it-IT/plg_datacompliance_s3.ini</language>
        <language tag="it-IT">it-IT/plg_datacompliance_s3.sys.ini</language>
        <language tag="pt-PT">pt-PT/plg_datacompliance_s3.ini</language>
        <language tag="pt-PT">pt-PT/plg_datacompliance_s3.sys.ini</language>
    </languages>

    <config addfieldpath="/administrator/components/com_datacompliance/fields">
        <fields name="params">
            <fieldset name="basic">
                <field name="access"
                       type="text"
                       default=""
                       label="PLG_DATACOMPLIANCE_S3_ACCESS_LABEL"
                       description="PLG_DATACOMPLIANCE_S3_ACCESS_DESC"
                       size="50"
                       filter="raw"/>

                <field name="secret"
                       type="password"
                       default=""
                       label="PLG_DATACOMPLIANCE_S3_SECRET_LABEL"
                       description="PLG_DATACOMPLIANCE_S3_SECRET_DESC"
                       size="50"
                       filter="raw"/>

                <field name="ssl"
                       type="radio"
                       layout="joomla.form.field.radio.switcher"
                       default="1"
                       label="PLG_DATACOMPLIANCE_S3_SSL_LABEL"
                       description="PLG_DATACOMPLIANCE_S3_SSL_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field name="bucket"
                       type="text"
                       default=""
                       label="PLG_DATACOMPLIANCE_S3_BUCKET_LABEL"
                       description="PLG_DATACOMPLIANCE_S3_BUCKET_DESC"/>

                <field name="path"
                       type="text"
                       default=""
                       label="PLG_DATACOMPLIANCE_S3_PATH_LABEL"
                       description="PLG_DATACOMPLIANCE_S3_PATH_DESC"/>

                <field name="method"
                       type="list"
                       default="v2"
                       label="PLG_DATACOMPLIANCE_S3_METHOD_LABEL"
                       description="PLG_DATACOMPLIANCE_S3_METHOD_DESC">
                    <option value="v2">PLG_DATACOMPLIANCE_S3_SIGNATURE_V2</option>
                    <option value="v4">PLG_DATACOMPLIANCE_S3_SIGNATURE_V4</option>
                </field>

                <field name="region"
                       type="list"
                       default="us-east-1"
                       label="PLG_DATACOMPLIANCE_S3_REGION_LABEL"
                       description="PLG_DATACOMPLIANCE_S3_REGION_DESC">
                    <option value="">PLG_DATACOMPLIANCE_S3_REGION_CUSTOM_OR_NONE</option>
                    <option value="useast1">PLG_DATACOMPLIANCE_S3_REGION_USEAST1</option>
                    <option value="useast2">PLG_DATACOMPLIANCE_S3_REGION_USEAST2</option>
                    <option value="uswest1">PLG_DATACOMPLIANCE_S3_REGION_USWEST1</option>
                    <option value="uswest2">PLG_DATACOMPLIANCE_S3_REGION_USWEST2</option>
                    <option value="cacentral1">PLG_DATACOMPLIANCE_S3_REGION_CACENTRAL1</option>
                    <option value="eucentral1">PLG_DATACOMPLIANCE_S3_REGION_EUCENTRAL1</option>
                    <option value="eucentral2">PLG_DATACOMPLIANCE_S3_REGION_EUCENTRAL2</option>
                    <option value="eunorth1">PLG_DATACOMPLIANCE_S3_REGION_EUNORTH1</option>
                    <option value="eusouth1">PLG_DATACOMPLIANCE_S3_REGION_EUSOUTH1</option>
                    <option value="eusouth2">PLG_DATACOMPLIANCE_S3_REGION_EUSOUTH2</option>
                    <option value="euwest1">PLG_DATACOMPLIANCE_S3_REGION_EUWEST1</option>
                    <option value="euwest2">PLG_DATACOMPLIANCE_S3_REGION_EUWEST2</option>
                    <option value="euwest3">PLG_DATACOMPLIANCE_S3_REGION_EUWEST3</option>
                    <option value="apeast1">PLG_DATACOMPLIANCE_S3_REGION_APEAST1</option>
                    <option value="apnortheast1">PLG_DATACOMPLIANCE_S3_REGION_APNORTHEAST1</option>
                    <option value="apnortheast2">PLG_DATACOMPLIANCE_S3_REGION_APNORTHEAST2</option>
                    <option value="apnortheast3">PLG_DATACOMPLIANCE_S3_REGION_APNORTHEAST3</option>
                    <option value="apsouth1">PLG_DATACOMPLIANCE_S3_REGION_APSOUTH1</option>
                    <option value="apsouth2">PLG_DATACOMPLIANCE_S3_REGION_APSOUTH2</option>
                    <option value="apsoutheast1">PLG_DATACOMPLIANCE_S3_REGION_APSOUTHEAST1</option>
                    <option value="apsoutheast2">PLG_DATACOMPLIANCE_S3_REGION_APSOUTHEAST2</option>
                    <option value="apsoutheast3">PLG_DATACOMPLIANCE_S3_REGION_APSOUTHEAST3</option>
                    <option value="apsoutheast4">PLG_DATACOMPLIANCE_S3_REGION_APSOUTHEAST4</option>
                    <option value="saeast1">PLG_DATACOMPLIANCE_S3_REGION_SAEAST1</option>
                    <option value="mecentral1">PLG_DATACOMPLIANCE_S3_REGION_MECENTRAL1</option>
                    <option value="mesouth1">PLG_DATACOMPLIANCE_S3_REGION_MESOUTH1</option>
                    <option value="afsouth1">PLG_DATACOMPLIANCE_S3_REGION_AFSOUTH1</option>
                    <option value="cnnorth1">PLG_DATACOMPLIANCE_S3_REGION_CNNORTH1</option>
                    <option value="cnnorthwest1">PLG_DATACOMPLIANCE_S3_REGION_CNNORTHWEST1</option>
                    <option value="usgoveast1">PLG_DATACOMPLIANCE_S3_REGION_USGOVEAST1</option>
                    <option value="usgoveast2">PLG_DATACOMPLIANCE_S3_REGION_USGOVEAST2</option>
                </field>

                <field name="custom_region"
                       type="text"
                       default=""
                       label="PLG_DATACOMPLIANCE_S3_CUSTOM_REGION_LABEL"
                       description="PLG_DATACOMPLIANCE_S3_CUSTOM_REGION_DESC"
                       showon="region:"
                />

                <field name="pathaccess"
                       type="radio"
                       default="0"
                       label="PLG_DATACOMPLIANCE_PATHACCESS_LABEL"
                       description="PLG_DATACOMPLIANCE_PATHACCESS_DESC">
                    <option value="0">PLG_DATACOMPLIANCE_PATHACCESS_VIRTUALHOST</option>
                    <option value="1">PLG_DATACOMPLIANCE_PATHACCESS_PATH</option>
                </field>

                <field name="class"
                       type="list"
                       default="0"
                       label="PLG_DATACOMPLIANCE_S3_CLASS_LABEL"
                       description="PLG_DATACOMPLIANCE_S3_CLASS_DESC">
                    <option value="STANDARD">PLG_DATACOMPLIANCE_S3_CLASS_STANDARD</option>
                    <option value="REDUCED_REDUNDANCY">PLG_DATACOMPLIANCE_S3_CLASS_REDUCED_REDUNDANCY</option>
                    <option value="STANDARD_IA">PLG_DATACOMPLIANCE_S3_CLASS_STANDARD_IA</option>
                    <option value="ONEZONE_IA">PLG_DATACOMPLIANCE_S3_CLASS_ONEZONE_IA</option>
                    <option value="INTELLIGENT_TIERING">PLG_DATACOMPLIANCE_S3_CLASS_INTELLIGENT_TIERING</option>
                    <option value="GLACIER">PLG_DATACOMPLIANCE_S3_CLASS_GLACIER</option>
                    <option value="DEEP_ARCHIVE">PLG_DATACOMPLIANCE_S3_CLASS_DEEP_ARCHIVE</option>
                </field>

                <field name="custom_endpoint"
                       type="text"
                       default=""
                       label="PLG_DATACOMPLIANCE_S3_CUSTOM_ENDPOINT_LABEL"
                       description="PLG_DATACOMPLIANCE_S3_CUSTOM_ENDPOINT_DESC"
                />

                <field name="alternateDateHeaderFormat"
                       type="radio"
                       layout="joomla.form.field.radio.switcher"
                       default="1"
                       label="PLG_DATACOMPLIANCE_S3_ALTERNATEDATEHEADERFORMAT_LABEL"
                       description="PLG_DATACOMPLIANCE_S3_ALTERNATEDATEHEADERFORMAT_DESC"
                       showon="custom_endpoint!:"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field name="useHTTPDateHeader"
                       type="radio"
                       layout="joomla.form.field.radio.switcher"
                       default="0"
                       label="PLG_DATACOMPLIANCE_S3_USEHTTPDATEHEADER_LABEL"
                       description="PLG_DATACOMPLIANCE_S3_USEHTTPDATEHEADER_DESC"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>

</extension>
