<extension type="plugin" group="datacompliance" method="upgrade">
    <name>PLG_DATACOMPLIANCE_ATS</name>
    <author>Nicholas K. Dionysopoulos</author>
    <authorEmail>nicholas@akeeba.com</authorEmail>
    <authorUrl>https://www.akeeba.com</authorUrl>
    <copyright>Copyright (c)2018-2025 Nicholas K. Dionysopoulos / Akeeba Ltd</copyright>
    <license>GNU General Public License version 3, or later</license>
    <creationDate>2026-09-25</creationDate>
    <version>4.1.0</version>
    <description>PLG_DATACOMPLIANCE_ATS_DESCRIPTION</description>
    <namespace path="src">Akeeba\Plugin\DataCompliance\ATS</namespace>
    <files>
        <folder>language</folder>
        <folder>services</folder>
        <folder plugin="ats">src</folder>

        <filename>.htaccess</filename>
        <filename>web.config</filename>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/plg_datacompliance_ats.ini</language>
        <language tag="en-GB">en-GB/plg_datacompliance_ats.sys.ini</language>
        <language tag="el-GR">el-GR/plg_datacompliance_ats.ini</language>
        <language tag="el-GR">el-GR/plg_datacompliance_ats.sys.ini</language>
        <language tag="fr-FR">fr-FR/plg_datacompliance_ats.ini</language>
        <language tag="fr-FR">fr-FR/plg_datacompliance_ats.sys.ini</language>
        <language tag="de-DE">de-DE/plg_datacompliance_ats.ini</language>
        <language tag="de-DE">de-DE/plg_datacompliance_ats.sys.ini</language>
        <language tag="es-ES">es-ES/plg_datacompliance_ats.ini</language>
        <language tag="es-ES">es-ES/plg_datacompliance_ats.sys.ini</language>
        <language tag="it-IT">it-IT/plg_datacompliance_ats.ini</language>
        <language tag="it-IT">it-IT/plg_datacompliance_ats.sys.ini</language>
        <language tag="pt-PT">pt-PT/plg_datacompliance_ats.ini</language>
        <language tag="pt-PT">pt-PT/plg_datacompliance_ats.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="export_managernotes"
                       type="radio"
                       layout="joomla.form.field.radio.switcher"
                       default="0"
                       label="PLG_DATACOMPLIANCE_ATS_EXPORT_MANAGERNOTES_LABEL"
                       description="PLG_DATACOMPLIANCE_ATS_EXPORT_MANAGERNOTES_DESC">
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
