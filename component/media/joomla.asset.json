{
	"$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
	"name": "com_datacompliance",
	"version": "4.1.0",
	"description": "Akeeba DataCompliance",
	"license": "GPL-3.0-or-later",
	"assets": [
		{
			"name": "com_datacompliance.backend",
			"description": "Backend CSS",
			"type": "style",
			"uri": "com_datacompliance/backend.css"
		},

		{
			"name": "com_datacompliance.j5",
			"description": "Backend CSS for Joomla! 5",
			"type": "style",
			"uri": "com_datacompliance/j5.css"
		},

		{
			"name": "com_datacompliance.controlpanel",
			"description": "Control Panel JavaScript",
			"type": "script",
			"uri": "com_datacompliance/controlpanel.min.js",
			"dependencies": [
				"core"
			],
			"attributes": {
				"defer": true
			}
		},

		{
			"name": "com_datacompliance.options",
			"description": "Data Options JavaScript",
			"type": "script",
			"uri": "com_datacompliance/options.min.js",
			"dependencies": [
				"core"
			],
			"attributes": {
				"defer": true
			}
		},

		{
			"name": "com_datacompliance.chart",
			"description": "Chart.js 3.2.1 — renders charts and graphs",
			"type": "script",
			"uri": "com_datacompliance/vendor/chart.min.js",
			"attributes": {
				"defer": true
			}
		},
		{
			"name": "com_datacompliance.chart_moment_adapter",
			"description": "Moment adapter 0.1.1 for Chart.js",
			"type": "script",
			"dependencies": [
				"com_datacompliance.chart",
				"com_datacompliance.moment"
			],
			"uri": "com_datacompliance/vendor/chartjs-adapter-moment.min.js",
			"attributes": {
				"defer": true
			}
		},
		{
			"name": "com_datacompliance.moment",
			"description": "Moment 2.31.0 — handles date conversions in JavaScript",
			"type": "script",
			"uri": "com_datacompliance/vendor/moment.min.js",
			"attributes": {
				"defer": true
			}
		},

		{
			"name": "com_datacompliance.backend",
			"type": "preset",
			"dependencies": [
				"com_datacompliance.backend#style"
			]
		}
	]
}